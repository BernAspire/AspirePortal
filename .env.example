# Copy to .env.local for local development. Never commit real values.
# Find these in Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (service-role key, Stripe, Anthropic) are added later,
# when a feature needs them, and only in Vercel's environment settings.
